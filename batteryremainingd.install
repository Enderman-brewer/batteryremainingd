# arg: 1 = new package version
post_install() {
    # Create the dedicated system user for the daemon if it doesn't exist.
    # The user needs no login shell or home directory — it only runs the daemon.
    if ! getent passwd batteryremaining_duser >/dev/null 2>&1; then
        useradd \
            --system \
            --shell /usr/bin/nologin \
            --no-create-home \
            --home-dir / \
            batteryremaining_duser
    fi
}

# arg: 1 = new package version, 2 = old package version
post_upgrade() {
    post_install
}

# arg: 1 = old package version
pre_remove() {
    :
}

# arg: 1 = old package version
post_remove() {
    # Remove the dedicated user — it is only used by this package.
    if getent passwd batteryremaining_duser >/dev/null 2>&1; then
        userdel batteryremaining_duser 2>/dev/null || true
    fi
}
